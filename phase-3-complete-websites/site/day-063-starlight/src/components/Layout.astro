---
import Header from './Header.astro';
import Footer from './Footer.astro';
const {
  title = 'Starlight Park',
  description = 'A new kind of public park for nature, play and shared discovery.',
  prefix = '',
  active = '',
  hideFooter = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7ea992" />
    <title>{title}</title>
    <link rel="icon" href={`${prefix}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${prefix}styles.css`} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <div class="scroll-progress" aria-hidden="true"><span data-progress></span></div>
    <div class="page-shell">
      <Header {prefix} {active} />
      <main><slot /></main>
      {!hideFooter && <Footer {prefix} />}
    </div>
    <script src={`${prefix}app.js`} defer></script>
  </body>
</html>
